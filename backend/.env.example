APP_NAME=Polonium
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polonium
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=polonium_embeddings

LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VECTOR_SIZE=768
LLM_PROVIDER=openai_compatible
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_THREADS=4
TRANSFORMERS_MODEL_ID=
TRANSFORMERS_MAX_NEW_TOKENS=512
EMBEDDING_PROVIDER=openai
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_CHARS=4000
EMBEDDING_NORMALIZE=True
FALLBACK_LLM_MODEL=
AI_CACHE_TTL_SECONDS=300

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
